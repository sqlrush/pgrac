#!/usr/bin/python3 -I
"""Linux management service entry for a dedicated root-owned code bundle.

Author: SqlRush <sqlrush@gmail.com>
Install beside target_*.py in a directory containing only these files. Do not
run a root management service from a developer-owned working tree. This entry
does not install, initialize, certify or open any storage configuration.
"""

import os
from pathlib import Path
import stat
import sys


def trusted_code():
    script = Path(os.path.abspath(__file__))
    for directory in reversed(script.parent.parents):
        status = directory.lstat()
        if (not stat.S_ISDIR(status.st_mode) or status.st_uid != 0
                or (status.st_mode & 0o022 and not status.st_mode & stat.S_ISVTX)):
            raise ValueError()
    status = script.parent.lstat()
    if not stat.S_ISDIR(status.st_mode) or status.st_uid != 0 or status.st_mode & 0o022:
        raise ValueError()
    found = set()
    for entry in script.parent.iterdir():
        status = entry.lstat()
        if (not stat.S_ISREG(status.st_mode) or status.st_uid != 0
                or status.st_mode & 0o022 or status.st_nlink != 1
                or not (entry.name == "pgrac-target-service"
                        or entry.name.startswith("target_") and entry.name.endswith(".py"))):
            raise ValueError()
        found.add(entry.name)
    if not {"pgrac-target-service", "target_service.py"} <= found:
        raise ValueError()
    return str(script.parent)


def main():
    if sys.platform != "linux" or os.geteuid() != 0 or not sys.flags.isolated:
        print("TARGET_SERVICE_PROCESS", file=sys.stderr)
        return 1
    try:
        directory = trusted_code()
    except Exception:
        print("TARGET_SERVICE_CODE", file=sys.stderr)
        return 1
    if sys.argv[1:] == ["--help"]:
        print("Usage: pgrac-target-service --config /absolute/protected/service.json")
        return 0
    if len(sys.argv) != 3 or sys.argv[1] != "--config":
        print("TARGET_SERVICE_ARGUMENT", file=sys.stderr)
        return 1
    os.umask(0o077)
    sys.dont_write_bytecode = True
    sys.path.insert(0, directory)
    try:
        from target_journal import TargetJournalError
        from target_service import run_service
    except Exception:
        print("TARGET_SERVICE_CODE", file=sys.stderr)
        return 1
    try:
        run_service(sys.argv[2])
        return 0
    except TargetJournalError as error:
        # All these errors are fixed internal reasons, not path/native text.
        reason = str(error)
        if not reason.startswith("TARGET_") or any(c not in "ABCDEFGHIJKLMNOPQRSTUVWXYZ_" for c in reason):
            reason = "TARGET_SERVICE_UNPROVEN"
        print(reason, file=sys.stderr)
        return 1
    except Exception:
        print("TARGET_SERVICE_UNPROVEN", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
