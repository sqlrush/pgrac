# Explicit test-first targets for the original joint source/H owner seam.
# Kept outside the shared test list while those interfaces are still RED.
include Makefile.k_h_report
.DEFAULT_GOAL := test_cluster_k_h_source_runtime

test_cluster_k_h_source_runtime: test_cluster_k_h_source_runtime.c test_cluster_wal_writer
	$(CC) $(CFLAGS) $(CPPFLAGS) -ffunction-sections -fdata-sections $< $(CLUSTER_WAL_CLAIM_O) \
		$(top_builddir)/src/backend/cluster/cluster_relmap_retention.o \
		xlogreader_fs.o $(top_builddir)/src/common/libpgcommon.a $(CLUSTER_UNIT_PORT_LIBS) \
		$(LDFLAGS) $(R4_RUNTIME_VIS_TEST_DEAD_STRIP) $(filter-out -lpgcommon -lpgport,$(LIBS)) -o $@

test_cluster_k_h_source_census: test_cluster_k_h_source_census.c test_cluster_relmap_retention_census
	$(CC) $(CFLAGS) $(CPPFLAGS) $< test_cluster_relmap_retention_census_product.o \
		$(top_builddir)/src/backend/cluster/cluster_relmap_pending.o \
		$(top_builddir)/src/backend/cluster/cluster_relmap_retention.o \
		$(top_builddir)/src/backend/cluster/cluster_wal_claim.o $(LDFLAGS) $(CLUSTER_UNIT_CRYPTOHASH_O) \
		$(top_builddir)/src/common/libpgcommon_srv.a $(CLUSTER_UNIT_PORT_LIBS) \
		$(R4_RUNTIME_VIS_TEST_DEAD_STRIP) $(filter-out -lpgcommon -lpgport,$(LIBS)) -o $@

test_cluster_k_h_protection: test_cluster_k_h_protection.c test_cluster_k_h_report
	$(CC) $(CFLAGS) $(CPPFLAGS) -ffunction-sections -fdata-sections $< \
		$(top_srcdir)/src/backend/cluster/cluster_heap_horizon.c \
		$(CLUSTER_VERSION_O) $(CLUSTER_UNDO_HORIZON_O) $(CLUSTER_XID_STRIPE_O) \
		$(CLUSTER_UNDO_RETENTION_O) $(top_builddir)/src/backend/storage/lmgr/s_lock.o \
		$(top_builddir)/src/common/libpgcommon_srv.a \
		$(R4_RUNTIME_VIS_TEST_DEAD_STRIP) $(CLUSTER_UNIT_PORT_LIBS) -o $@
