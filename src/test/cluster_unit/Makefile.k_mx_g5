		$(top_srcdir)/src/include/cluster/cluster_multixact_range.h
	$(CC) $(CFLAGS) $(CPPFLAGS) -DUSE_CLUSTER_UNIT -ffunction-sections -fdata-sections \
		-c $< -o $@

