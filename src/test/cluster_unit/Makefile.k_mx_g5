$(K_MX_FULL_RECOMPOSE_TRANSAM_O): $(top_srcdir)/src/backend/access/transam/transam.c
	$(CC) $(CFLAGS) $(CPPFLAGS) -ffunction-sections -fdata-sections -c $< -o $@
