		unit_test.h $(MX_COMPOSITION_O) $(MX_RANGE_WIRE_O) \
		$(K_MX_FULL_RECOMPOSE_O) $(K_MX_FULL_RECOMPOSE_CURRENT_O) \
		$(K_MX_FULL_RECOMPOSE_TRANSAM_O) $(top_builddir)/src/port/libpgport_srv.a
	$(CC) $(CFLAGS) $(CPPFLAGS) $< $(MX_COMPOSITION_O) $(MX_RANGE_WIRE_O) \
		$(K_MX_FULL_RECOMPOSE_O) $(K_MX_FULL_RECOMPOSE_CURRENT_O) \
		$(K_MX_FULL_RECOMPOSE_TRANSAM_O) $(R4_RUNTIME_VIS_TEST_DEAD_STRIP) \
		$(top_builddir)/src/port/libpgport_srv.a -o $@

