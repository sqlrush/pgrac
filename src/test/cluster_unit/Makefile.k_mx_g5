# Standalone legacy-domain gates; intentionally outside the default test list.
test_k_mx_g5_legacy_domain: test_k_mx_g5_legacy_domain.c \
		test_cluster_multixact_current.c unit_test.h \
		$(CLUSTER_MULTIXACT_CURRENT_O) $(CLUSTER_MULTIXACT_CURRENT_WIRE_O) \
		$(CLUSTER_CR_SERVER_C0_TEST_O) $(CLUSTER_MULTIXACT_MATERIALIZER_TEST_O)
	$(CC) $(CFLAGS) $(CPPFLAGS) $< \
		-DHEAPAM_CURRENT_MX_SOURCE_PATH='"$(top_srcdir)/src/backend/access/heap/heapam.c"' \
		-DMULTIXACT_SOURCE_PATH='"$(top_srcdir)/src/backend/access/transam/multixact.c"' \
		$(CLUSTER_MULTIXACT_CURRENT_O) $(CLUSTER_MULTIXACT_CURRENT_WIRE_O) \
		$(CLUSTER_CR_SERVER_C0_TEST_O) $(CLUSTER_MULTIXACT_MATERIALIZER_TEST_O) \
		$(R4_RUNTIME_VIS_TEST_DEAD_STRIP) \
		$(top_builddir)/src/common/libpgcommon_srv.a $(CLUSTER_UNIT_PGPORT) -o $@

# Standalone range codec; no caller or HELLO activation.
K_MX_G5_CPPFLAGS ?=
K_MX_G5_CODEC_OBJECTS ?= $(top_builddir)/src/backend/cluster/cluster_multixact_range_wire.o
test_k_mx_g5_range_contract: test_k_mx_g5_range_contract.c \
		test_cluster_multixact_current.c unit_test.h \
		$(CLUSTER_MULTIXACT_CURRENT_O) $(CLUSTER_MULTIXACT_CURRENT_WIRE_O) \
		$(CLUSTER_CR_SERVER_C0_TEST_O) $(CLUSTER_MULTIXACT_MATERIALIZER_TEST_O) \
		$(K_MX_G5_CODEC_OBJECTS)
	$(CC) $(CFLAGS) $(K_MX_G5_CPPFLAGS) $(CPPFLAGS) $< \
		-DHEAPAM_CURRENT_MX_SOURCE_PATH='"$(top_srcdir)/src/backend/access/heap/heapam.c"' \
		-DMULTIXACT_SOURCE_PATH='"$(top_srcdir)/src/backend/access/transam/multixact.c"' \
		$(CLUSTER_MULTIXACT_CURRENT_O) $(CLUSTER_MULTIXACT_CURRENT_WIRE_O) \
		$(CLUSTER_CR_SERVER_C0_TEST_O) $(CLUSTER_MULTIXACT_MATERIALIZER_TEST_O) \
		$(K_MX_G5_CODEC_OBJECTS) $(R4_RUNTIME_VIS_TEST_DEAD_STRIP) \
		$(top_builddir)/src/common/libpgcommon_srv.a $(CLUSTER_UNIT_PGPORT) -o $@
