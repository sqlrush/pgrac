# Standalone legacy-domain gates; intentionally outside the default test list.
test_k_mx_g5_legacy_domain: test_k_mx_g5_legacy_domain.c \
		test_cluster_multixact_current.c unit_test.h \
		$(CLUSTER_MULTIXACT_CURRENT_O) $(CLUSTER_MULTIXACT_CURRENT_WIRE_O) \
		$(CLUSTER_CR_SERVER_C0_TEST_O) $(CLUSTER_MULTIXACT_MATERIALIZER_TEST_O)
	$(CC) $(CFLAGS) $(CPPFLAGS) $< \
		-DHEAPAM_CURRENT_MX_SOURCE_PATH='"$(top_srcdir)/src/backend/access/heap/heapam.c"' \
		-DMULTIXACT_SOURCE_PATH='"$(top_srcdir)/src/backend/access/transam/multixact.c"' \
		$(CLUSTER_MULTIXACT_CURRENT_O) $(CLUSTER_MULTIXACT_CURRENT_WIRE_O) \
		$(CLUSTER_CR_SERVER_C0_TEST_O) $(CLUSTER_MULTIXACT_MATERIALIZER_TEST_O) \
		$(R4_RUNTIME_VIS_TEST_DEAD_STRIP) \
		$(top_builddir)/src/common/libpgcommon_srv.a $(top_builddir)/src/port/libpgport_srv.a -o $@

test_k_mx_g5_service: test_k_mx_g5_service.c test_cluster_mx_native_range.c \
		test_cluster_mx_composition.c unit_test.h \
		$(top_srcdir)/src/backend/access/transam/multixact.c \
		$(top_builddir)/src/backend/cluster/cluster_multixact_range.o \
		$(top_builddir)/src/backend/cluster/cluster_multixact_range_wire.o \
		$(top_builddir)/src/backend/cluster/cluster_multixact_current_stats.o \
		$(top_builddir)/src/backend/cluster/cluster_multixact_composition.o
	$(CC) $(CFLAGS) $(CPPFLAGS) -ffunction-sections -fdata-sections $< \
		$(top_builddir)/src/backend/cluster/cluster_multixact_range.o \
		$(top_builddir)/src/backend/cluster/cluster_multixact_range_wire.o \
		$(top_builddir)/src/backend/cluster/cluster_multixact_current_stats.o \
		$(top_builddir)/src/backend/cluster/cluster_multixact_composition.o \
		$(R4_RUNTIME_VIS_TEST_DEAD_STRIP) $(top_builddir)/src/port/libpgport_srv.a -o $@

test_k_mx_g5_transport: test_k_mx_g5_transport.c unit_test.h \
		$(top_srcdir)/src/backend/cluster/cluster_gcs_block.c \
		$(top_builddir)/src/backend/cluster/cluster_multixact_range_wire.o
	$(CC) $(CFLAGS) $(CPPFLAGS) -ffunction-sections -fdata-sections $< \
		$(top_builddir)/src/backend/cluster/cluster_multixact_range_wire.o \
		$(R4_RUNTIME_VIS_TEST_DEAD_STRIP) $(top_builddir)/src/port/libpgport_srv.a -o $@

test_k_mx_g5_shard: test_k_mx_g5_shard.c test_cluster_gcs_block_shard.c unit_test.h \
		$(CLUSTER_GCS_BLOCK_SHARD_O) $(CLUSTER_LMS_SHARD_O) \
		$(CLUSTER_RESOURCE_X_IDENTITY_O) $(CLUSTER_RESOURCE_X_NODE_WIRE_O)
	$(CC) $(CFLAGS) $(CPPFLAGS) $< \
		$(CLUSTER_GCS_BLOCK_SHARD_O) $(CLUSTER_LMS_SHARD_O) \
		$(CLUSTER_RESOURCE_X_IDENTITY_O) $(CLUSTER_RESOURCE_X_NODE_WIRE_O) \
		$(top_builddir)/src/common/libpgcommon_srv.a $(CLUSTER_UNIT_PORT_LIBS) -o $@

K_MX_NATIVE_CALLER_O = $(top_builddir)/src/backend/cluster/cluster_multixact_range.o \
	$(top_builddir)/src/backend/cluster/cluster_multixact_composition.o \
	$(top_builddir)/src/backend/cluster/cluster_cr_server.o \
	$(top_builddir)/src/backend/cluster/cluster_multixact_current_stats.o \
	$(CLUSTER_GCS_BLOCK_SHARD_O) $(CLUSTER_LMS_SHARD_O) \
	$(CLUSTER_RESOURCE_X_IDENTITY_O) $(CLUSTER_RESOURCE_X_NODE_WIRE_O)
test_k_mx_g5_native_caller: test_k_mx_g5_native_caller.c test_k_mx_g5_service.c \
		test_cluster_mx_native_range.c test_cluster_mx_composition.c unit_test.h \
		$(top_srcdir)/src/backend/access/transam/multixact.c \
		$(top_srcdir)/src/backend/cluster/cluster_gcs_block.c $(K_MX_NATIVE_CALLER_O)
	$(CC) $(CFLAGS) $(CPPFLAGS) -ffunction-sections -fdata-sections $< \
		$(K_MX_NATIVE_CALLER_O) $(R4_RUNTIME_VIS_TEST_DEAD_STRIP) \
		$(top_builddir)/src/common/libpgcommon_srv.a $(top_builddir)/src/port/libpgport_srv.a -o $@

# Standalone range codec; no caller or HELLO activation.
K_MX_G5_CPPFLAGS ?=
K_MX_G5_CODEC_OBJECTS ?= $(top_builddir)/src/backend/cluster/cluster_multixact_range_wire.o
test_k_mx_g5_range_contract: test_k_mx_g5_range_contract.c \
		test_cluster_multixact_current.c unit_test.h \
		$(CLUSTER_MULTIXACT_CURRENT_O) $(CLUSTER_MULTIXACT_CURRENT_WIRE_O) \
		$(CLUSTER_CR_SERVER_C0_TEST_O) $(CLUSTER_MULTIXACT_MATERIALIZER_TEST_O) \
		$(K_MX_G5_CODEC_OBJECTS)
	$(CC) $(CFLAGS) $(K_MX_G5_CPPFLAGS) $(CPPFLAGS) $< \
		-DHEAPAM_CURRENT_MX_SOURCE_PATH='"$(top_srcdir)/src/backend/access/heap/heapam.c"' \
		-DMULTIXACT_SOURCE_PATH='"$(top_srcdir)/src/backend/access/transam/multixact.c"' \
		$(CLUSTER_MULTIXACT_CURRENT_O) $(CLUSTER_MULTIXACT_CURRENT_WIRE_O) \
		$(CLUSTER_CR_SERVER_C0_TEST_O) $(CLUSTER_MULTIXACT_MATERIALIZER_TEST_O) \
		$(K_MX_G5_CODEC_OBJECTS) $(R4_RUNTIME_VIS_TEST_DEAD_STRIP) \
		$(top_builddir)/src/common/libpgcommon_srv.a $(top_builddir)/src/port/libpgport_srv.a -o $@
